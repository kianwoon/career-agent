# Backend environment (local development). Copy to .env and adjust.
APP_NAME="Career Agent API"
DEBUG=false

# Postgres
DATABASE_URL="postgresql+asyncpg://career:career@localhost:5432/career_agent"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="career_documents"

# Steel browser service (leave empty to use local Playwright)
STEEL_API_URL=""
STEEL_API_KEY=""

# LLM (optional, not required for Phase 1 deterministic path)
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Z.AI GLM coding-plan LLM (optional enhancement layer)
# Requests are wrapped with AI coding-tool headers to use the coding plan.
LLM_ENABLED=false
LLM_BASE_URL="https://api.z.ai/api/anthropic/v1/messages"
LLM_API_KEY="your-zai-coding-plan-key"
LLM_MODEL_NAME="GLM-5.3"
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_SESSION_NAME="career-agent"

# Approval policy
APPROVALS_ENABLED=true

# Polite pacing (human-like browser usage, avoids anti-robot detection)
PACING_MIN_DELAY_MS=1500
PACING_MAX_DELAY_MS=4000
PACING_MAX_PAGES_PER_MIN=12
PACING_THROTTLE_WINDOW_S=60
PACING_MIN_SEARCH_GAP_S=45
PACING_CIRCUIT_BREAKER_S=300

# CORS
CORS_ORIGINS='["http://localhost:3000"]'

# External API security
# Comma-separated API keys; optional ":N" suffix = per-key requests/minute.
# Leave empty to disable auth (dev only — NOT for external use).
API_KEYS=""
API_RATE_LIMIT_PER_MIN=30

# Browser session encryption (AES-256-GCM). 64 hex chars (32 bytes).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty to derive a dev key (warns at startup; NOT for production).
SESSION_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Browser proxy (residential proxy / SOCKS5 tunnel)
# When set, all browser traffic egresses through this proxy instead of the
# container's own IP. Use a residential IP so LinkedIn sees a trusted address.
# PROXY_URL="socks5://host:1080"        # or http://host:8080
# PROXY_USERNAME=""
# PROXY_PASSWORD=""
