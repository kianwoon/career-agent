# Steel Browser Runtime - Phase 1 configuration
#
# Steel is the self-hosted cloud browser/session runtime. Each user gets a
# persistent browser profile; sessions survive restart; the agent controls the
# browser through a narrow API (see backend/app/services/browser.py).
#
# Local mode (default): the backend uses local Playwright + Chromium.
# Cloud mode: point STEEL_API_URL at the Steel service and provide the key.

# Base URL of the Steel service (self-hosted).
STEEL_API_URL: ""
# API key for Steel (obtain from `steel env list` or your deployment).
STEEL_API_KEY: ""

# Browser engine / launch options
STEEL_BROWSER: "chromium"
STEEL_HEADLESS: true
STEEL_VIEWPORT: "1280x800"

# Region stability: keep sessions region-stable (do not rotate).
STEEL_REGION: "singapore"

# Session persistence: profiles stored per user, reused across tasks.
STEEL_PROFILE_DIR: "/data/steel/profiles"
STEEL_SESSION_TTL_DAYS: 30

# Security: never expose the Steel control endpoint to the public internet.
STEEL_BIND_ADDR: "127.0.0.1"
STEEL_BIND_PORT: 3000
