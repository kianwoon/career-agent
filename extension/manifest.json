{
  "manifest_version": 3,
  "name": "Career Agent Browser",
  "version": "1.7.1",
  "description": "Lets the Career Agent cloud run job/candidate searches in YOUR logged-in browser. No tunnels, no server browsers, no blocks.",
  "permissions": ["scripting", "tabs", "storage", "cookies", "alarms"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://career-agent-kianwoon-88223cd5.koyeb.app/*", "https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Career Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" }
}
